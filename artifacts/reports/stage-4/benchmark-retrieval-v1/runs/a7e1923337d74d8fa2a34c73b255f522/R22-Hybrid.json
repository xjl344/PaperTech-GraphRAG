      "parse_id": "parse_217ebb369e3e37f49880d5140e30b94c",
      "title": "CuriousLLM: Elevating Multi-Document QA with Reasoning-Infused Knowledge Graph Prompting",
      "page_start": 1,
      "page_end": 1,
      "source_relative_path": "Methods/059_CuriousLLM Elevating Multi-Document QA with Reasoning-Infused Knowledge Graph Prompting.pdf",
      "source_spans": [
        {
