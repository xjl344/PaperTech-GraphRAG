      "parse_id": "parse_812f4632a5e55f54711742cc1a3a8d45",
      "title": "Reasoning on Graphs: Faithful and Interpretable Large Language Model Reasoning",
      "page_start": 1,
      "page_end": 1,
      "source_relative_path": "Methods/191_Reasoning on Graphs Faithful and Interpretable Large Language Model Reasoning.pdf",
      "source_spans": [
