      "parse_id": "parse_ade4a33d5a1fe3868f2e9bf4ed4de363",
      "title": "Learning to Plan for Retrieval-Augmented Large Language Models from Knowledge Graphs",
      "page_start": 2,
      "page_end": 2,
      "source_relative_path": "Methods/024_Learning to Plan for Retrieval-Augmented Large Language Models from Knowledge Graphs.pdf",
      "source_spans": [
        {
