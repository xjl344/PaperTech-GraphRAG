# Local runtime and reproducible extraction outputs; keep reports and frozen manifests reviewable.
.venv/
.cache/
__pycache__/
*.py[cod]
data/extracted/
data/ingest.sqlite3*
.env
.runtime/
data/rag.sqlite3*
data/embeddings.sqlite3*
data/cloud-compatibility.json

# --- GitHub clean-code release: never publish raw PDFs, local DBs, secrets or caches ---
database/
data/*.sqlite3*
data/*.json
.mypy_cache/
.pytest_cache/
torchinductor_*/
**/langsmith-experiments.json
*.log
.env.*
!.env.example

