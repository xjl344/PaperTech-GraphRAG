# Cloudflare Workers AI. Fill Account ID and API Token; no CLOUD_BGE_API_KEY needed.
CLOUD_BGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUD_BGE_BASE_URL=
CLOUD_BGE_API_KEY=
CLOUD_BGE_MODEL=@cf/baai/bge-m3
# auto: use local without a key; select cloud with a key (compatibility gate still applies).
QUERY_EMBEDDING_MODE=auto
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Existing inference environment is read-only; override if you create a dedicated one.
LOCAL_MODEL_PYTHON=E:/AI-Agent/RAG/bge_m3_local_demo/.venv/Scripts/python.exe
LOCAL_BGE_PATH=E:/AI-Infra/models/embeddings/bge-m3
LOCAL_RERANKER_PATH=E:/AI-Infra/models/reranker/bge-reranker
LOCAL_MODEL_DEVICE=cpu
# Optional separate reranker configuration. CUDA requires a CUDA-enabled PyTorch environment.
LOCAL_RERANKER_DEVICE=cuda
LOCAL_RERANKER_DTYPE=float16
LOCAL_RERANKER_PYTHON=E:/PaperTech-GraphRAG/.runtime/gpu-reranker/Scripts/python.exe
# Reuse within the parent process; a new CLI process still starts cold.
LOCAL_RERANKER_PERSISTENT=true
# Only record actual usage tokens; do not estimate currency costs.
TOKEN_ONLY=true
# Legacy price fields retained for older exports; unused when TOKEN_ONLY=true.
CLOUD_BGE_INPUT_PRICE=
DEEPSEEK_INPUT_PRICE=
DEEPSEEK_CACHED_INPUT_PRICE=
DEEPSEEK_OUTPUT_PRICE=
